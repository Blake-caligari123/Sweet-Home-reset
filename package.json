{
  "name": "sweet-home-reset",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, local-first cleaning game with Puff the dust bunny.",
  "packageManager": "npm@10",
  "scripts": {
    "dev": "npm run dev --workspace @sweet-home-reset/web",
    "dev:web": "npm run dev --workspace @sweet-home-reset/web",
    "dev:api": "npm run dev --workspace @sweet-home-reset/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "art:placeholders": "node scripts/generate-art-placeholders.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0"
  }
}
